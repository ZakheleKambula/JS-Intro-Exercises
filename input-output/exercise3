//Exercise 3: modify the age.js program to ask for the user's age
let name = 'Zee';
let rlSy = require('readline-sync');
let age = Number(rlSy.question('What is your age?\n'));
console.log(`${name} is ${age} years old.`);
console.log(`${name} will be ${age + 10} years old in ten years.`);
console.log(`${name} will be ${age + 20} years old in twenty years.`);
console.log(`${name} will be ${age + 30} years old in thirty years.`);
console.log(`${name} will be ${age + 40} years old in forty years.`);

